{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoBaselineMigrationHistory": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=LiftOpsDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_ENV_JWT_KEY",
    "Issuer": "LiftOpsBackEnd",
    "Audience": "LiftOpsBackEnd",
    "DurationInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Maintenance": {
    "PdfAccessTokenLifetimeMinutes": 15
  },
  "PlatformAdmin": {
    "SeedOnStartup": false,
    "Email": "admin@liftops.com",
    "Password": "",
    "FullName": "Platform Administrator"
  }
}
