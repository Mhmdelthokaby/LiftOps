# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lifops?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-key-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars"
JWT_ACCESS_EXPIRY_MINUTES="15"
JWT_REFRESH_EXPIRY_DAYS="7"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LiftOps"

# Tenant (for platform admin)
PLATFORM_ADMIN_COMPANY_ID="00000000-0000-0000-0000-000000000000"

# Optional: File Upload
# UPLOADTHING_SECRET=""
# UPLOADTHING_APP_ID=""

# Optional: Stripe
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PLAN_PRICE_IDS=""

# Optional: Email
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# FROM_EMAIL="noreply@lifops.com"

# Optional: Redis (for BullMQ)
# REDIS_URL="redis://localhost:6379"
